"/turret_view" [shape=ellipse, style=filled, fillcolor="#E7F1F0", color="#0E7C86"];
"/camera/camera/color/camera_info" [shape=box, style="rounded", color="#8FA2B0", fontcolor="#3D4C58", fontsize=11];
