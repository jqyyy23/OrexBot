"/tf" [shape=box, style="rounded", color="#8FA2B0", fontcolor="#3D4C58", fontsize=11];
"/tf_static" [shape=box, style="rounded", color="#8FA2B0", fontcolor="#3D4C58", fontsize=11];
"/camera/camera/color/camera_info" -> "/turret_view";
"/camera/camera/color/image_raw" -> "/turret_view";
"/fake_target_node" -> "/target_point";
"/fake_target_node" -> "/target_server/update";
"/head/joint_states" -> "/joint_state_publisher";
"/head/target_locked" -> "/turret_view";
"/head/target_point" -> "/turret_view";
"/head/target_velocity" -> "/turret_view";
