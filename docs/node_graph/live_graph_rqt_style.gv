"/head/target_velocity" [shape=box, style="rounded", color="#8FA2B0", fontcolor="#3D4C58", fontsize=11];
"/joint_states" [shape=box, style="rounded", color="#8FA2B0", fontcolor="#3D4C58", fontsize=11];
"/joint_velocities" [shape=box, style="rounded", color="#8FA2B0", fontcolor="#3D4C58", fontsize=11];
"/robot_description" [shape=box, style="rounded", color="#8FA2B0", fontcolor="#3D4C58", fontsize=11];
"/target_point" [shape=box, style="rounded", color="#8FA2B0", fontcolor="#3D4C58", fontsize=11];
"/target_server/feedback" [shape=box, style="rounded", color="#8FA2B0", fontcolor="#3D4C58", fontsize=11];
