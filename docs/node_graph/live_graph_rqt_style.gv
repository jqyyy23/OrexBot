digraph G {
rankdir=TB; nodesep=0.4; ranksep=0.45; bgcolor="#FFFFFF";
node [fontname="Helvetica", fontsize=12];
edge [color="#3D4C58", arrowsize=0.7];
"/fake_target_node" [shape=ellipse, style=filled, fillcolor="#E7F1F0", color="#0E7C86"];
