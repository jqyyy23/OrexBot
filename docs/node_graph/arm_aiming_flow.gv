// Gun-arm aiming pipeline, as running live (orex_sim + head_state launch).
// Nodes = ellipses, topics = edge labels. Top-down.
digraph ArmAiming {
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="#FFFFFF", nodesep=0.5, ranksep=0.55, pad=0.3];
  node  [fontname="Helvetica", fontsize=13, shape=box, style="rounded,filled", fillcolor="#E7F1F0", color="#0E7C86", penwidth=1.5, width=3.2];
  edge  [fontname="Courier", fontsize=11, color="#14202B", fontcolor="#0A5A62", penwidth=1.4];

  target [label="fake_target_node\nmovable test target in RViz", style="rounded,filled,dashed"];
  ik     [label="ik_solver_node\nsolves joint velocities to aim at target", fillcolor="#FFE9C7", color="#B4461F", penwidth=2];
  mock   [label="mock_hardware_node\nintegrates velocities into joint angles"];
  rsp    [label="robot_state_publisher\nURDF → link poses"];
  rviz   [label="RViz\narm follows the target", fillcolor="#D6E7F5"];

  target -> ik   [label="  /target_point"];
  ik     -> mock [label="  /joint_velocities"];
  mock   -> rsp  [label="  /joint_states"];
  rsp    -> rviz [label="  /tf"];
  rsp    -> ik   [label="/tf  (current arm pose)", style=dashed, constraint=false];
}
